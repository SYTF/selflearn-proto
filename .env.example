# Pooled Neon connection string (contains -pooler in the host).
# Set this in Vercel Project Settings → Environment Variables. Do not commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional. Used to sign the httpOnly session cookie. Set a long random string in Vercel.
SESSION_SECRET=change-me-in-vercel

# SSO: Admin UI stores provider secrets in sso_providers.credentials (DB JSON).
# Env overrides such as EDCITY_* / GOOGLE_* are not read yet; do not put real secrets here.
